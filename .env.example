# Server Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
MONGODB_URI=mongodb://mongo:27017/healthcare_db

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=1h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Encryption Key for PHI (Protected Health Information)
PHI_ENCRYPTION_KEY=your-256-bit-encryption-key-here

# Audit Log
AUDIT_LOG_ENABLED=true
